# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_registration

# Security
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Application
APP_URL=http://localhost:8000
APP_NAME=AI Event Registration
DEBUG=true
DEMO_MODE=true
DEMO_PAYMENT_MODE=true

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
